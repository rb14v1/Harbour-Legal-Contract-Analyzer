# =============================================================================
# Legal Contract Analyzer - backend environment configuration
# Copy this file to `.env` and adjust values for your environment.
# All values are read via python-decouple's config() in settings.py.
# =============================================================================

# --- Core Django ---
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database mode toggle ---
# USE_SQLITE=True  -> backend runs on local SQLite AND every external Azure
#                     service below runs in deterministic-stub mode (no
#                     network calls, no cost, nothing to configure). This is
#                     the mode `manage.py test` and CI always run under.
# USE_SQLITE=False -> backend connects to the real Postgres instance
#                     described by the POSTGRES_* vars below. Azure services
#                     still fall back to stub mode individually, unless their
#                     own AZURE_*/OPENAI_* vars are filled in. Postgres here
#                     is PLAIN relational storage only - no pgvector
#                     extension and no vector columns. All embedding/vector
#                     storage goes through the Azure AI Search abstraction
#                     (backend/apps/common/search_store.py), which itself
#                     falls back to an in-memory cosine-similarity index when
#                     AZURE_SEARCH_* is not configured.
USE_SQLITE=True

# --- Postgres (used only when USE_SQLITE=False) ---
# Native Postgres running on localhost:5432. No extensions required.
POSTGRES_DB=legal_contract_analyzer
POSTGRES_USER=legal_contract_analyzer
POSTGRES_PASSWORD=legal_contract_analyzer
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- JWT ---
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# =============================================================================
# Azure service integrations - every one of these is OPTIONAL in dev.
# Leave any of them blank and backend/apps/common/*.py transparently falls
# back to a deterministic, local, network-free stub implementation with the
# exact same function signatures as the real SDK-backed path. This lets the
# whole app (upload -> extract -> chunk/embed -> index -> search -> answer)
# run end to end with zero external dependencies and zero cost.
# =============================================================================

# Azure Blob Storage (backend/apps/common/blob_store.py)
# When blank: documents are written to/read from MEDIA_ROOT/blob_stub/ on disk.
AZURE_STORAGE_CONNECTION_STRING=

# Azure AI Document Intelligence (backend/apps/common/document_intelligence.py)
# When either is blank: a deterministic stub parses uploaded text into fake
# (but reproducible, SHA256-seeded) clauses/classifications instead of
# calling the real prebuilt-layout/prebuilt-document model.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# Azure OpenAI (backend/apps/common/ai.py) - chat completions + embeddings
# When either is blank: chat replies and embedding vectors are deterministic
# SHA256-seeded stubs instead of real Azure OpenAI calls.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
OPENAI_CHAT_MODEL=gpt-5.6-sol
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=1536

# Azure AI Search (backend/apps/common/search_store.py) - vector/hybrid search
# When either is blank: an in-process in-memory index (per index name) with
# plain-Python cosine-similarity top-k search is used instead of a real
# Azure Cognitive Search index. Not persisted across process restarts.
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX=contract_chunks

# --- CORS (frontend dev server) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
